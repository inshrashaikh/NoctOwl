{
  "id": null,
  "uid": "noctowl-overview",
  "title": "NoctOwl Observability Overview",
  "tags": ["noctowl", "api", "ai-service"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Request Rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(noctowl_http_requests_total[5m])) by (route)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 Latency (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(noctowl_http_request_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Emergency Notification Delivery Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(noctowl_emergency_notifications_total{status=\"delivered\"}[5m])) / clamp_min(sum(rate(noctowl_emergency_notifications_total[5m])), 1)"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "BullMQ Queue Depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "noctowl_bullmq_queue_depth"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI Risk Assessment Request Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(noctowl_risk_requests_total[5m])) by (status)"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Service Error Logs (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"api|ai-service\"} |~ \"(?i)error\""
        }
      ]
    }
  ]
}
