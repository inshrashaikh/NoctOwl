# NoctOwl Environment Variables
# Copy this file to .env and replace placeholder credentials before starting services.

# PostgreSQL + PostGIS
POSTGRES_USER=noctowl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=noctowl
DATABASE_URL=postgresql://noctowl:changeme@localhost:5432/noctowl?schema=public

# Redis
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# API & JWT
PORT=3000
JWT_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
WEB_ORIGIN=*
# Add the LAN IP of the machine running Docker (and the Expo dev port) when
# testing the web/mobile client from another device on the same network.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Valhalla Routing Engine
VALHALLA_URL=http://valhalla:8002

# AI Risk Service
AI_SERVICE_URL=http://ai-service:8000

# Firebase Cloud Messaging (JSON string of Firebase service account)
FCM_SERVICE_ACCOUNT_JSON=

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=noctowl

# Observability & Security (M6)
SENTRY_DSN_API=
SENTRY_DSN_WEB=
NEXT_PUBLIC_SENTRY_DSN_WEB=
OTEL_EXPORTER_OTLP_ENDPOINT=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# CI/CD & Production Registry (M7)
GITHUB_REPOSITORY=your-org/noctowl
TAG=latest

# Database Backups (M8)
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_BUCKET=noctowl-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=7
